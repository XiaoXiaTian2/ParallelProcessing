<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- 相對路徑以執行檔所在資料夾為基準，也可填絕對路徑 -->
        <add key="InputFolder" value="data"/>
        <add key="OutputFolder" value="outputData"/>
    </appSettings>
</configuration>